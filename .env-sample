# 🚀 일반 게시판 로컬 개발 환경 변수 설정 샘플 (.env-sample)
# 이 파일을 복사하여 .env 파일을 생성하고 실제 연결 정보를 채우십시오.
# (주의: .env 파일은 Git 추적에서 제외되어 있으므로 자격 증명이 유출되지 않습니다.)

# 1. API 서버 구동 포트 (Vite Proxy와 일치해야 함)
PORT=3000

# 2. Turso Cloud DB 연동 설정
# - 실제 운영 시에는 Turso Cloud에서 발급받은 데이터베이스 URL과 인증 토큰을 아래에 입력합니다.
# - 만약 비워두거나 값을 입력하지 않으면, 자동으로 로컬 SQLite 파일 데이터베이스(file:local.db)로 연결되어 동작합니다.
TURSO_DB_URL=
TURSO_DB_TOKEN=
